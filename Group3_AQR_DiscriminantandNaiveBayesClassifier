        "\n",
        "# extract the mean and standard deviation of each feature for Down and Up months\n",
        "nb.tab <- sapply(nb.fit$tables, function(m) c(m[\"Down\", 1], m[\"Up\", 1], m[\"Down\", 2], m[\"Up\", 2]))\n",
        "rownames(nb.tab) <- c(\"mean_Down\", \"mean_Up\", \"sd_Down\", \"sd_Up\")\n",
        "\n",
        "# compare the standard deviations before Down and Up months\n",
        "round(rbind(nb.tab, sd_ratio_Down_Up = nb.tab[\"sd_Down\", ] / nb.tab[\"sd_Up\", ]), 4)"
